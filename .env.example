# Compose and shared-network identity. Other Compose projects join this network.
LOCAL_BROKER_PROJECT_NAME=local-broker
LOCAL_BROKER_NETWORK=local-broker

# Loopback is the safe default. Use 0.0.0.0 only when intentionally exposing
# selected routes to a trusted LAN and after applying route-level protections.
LOCAL_BROKER_BIND_IP=127.0.0.1
LOCAL_BROKER_HTTP_PORT=80
LOCAL_BROKER_HTTPS_PORT=443

LOCAL_BROKER_LOG_LEVEL=INFO
LOCAL_BROKER_ACCESS_LOG=false

# Override for rootless Docker or Podman-compatible sockets.
LOCAL_BROKER_SOCKET_PATH=/var/run/docker.sock

# Image overrides are optional. Defaults are pinned in compose.yaml.
# LOCAL_BROKER_TRAEFIK_IMAGE=traefik:v3.7
# LOCAL_BROKER_SOCKET_PROXY_IMAGE=lscr.io/linuxserver/socket-proxy:3.4.4-r0-ls97
